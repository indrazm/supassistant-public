# Redis connection for BullMQ (default: redis://127.0.0.1:6379)
REDIS_URL=redis://127.0.0.1:6379

# Neo4j graph store (defaults: bolt://127.0.0.1:7687, neo4j, devpassword)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devpassword

# Qdrant vector store (default: http://127.0.0.1:6333)
QDRANT_URL=http://127.0.0.1:6333
