# Port the HTTP server binds to (default: 3000)
PORT=3000

# Postgres connection string (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://superassistant:superassistant-dev@localhost:54329/superassistant

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Base URL of this API
BETTER_AUTH_URL=http://localhost:3000
# Frontend origin, trusted for auth requests (Vite dev server)
WEB_ORIGIN=http://localhost:5173
