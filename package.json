{
  "name": "superassistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt",
    "with-env": "dotenv -e .env --",
    "api:dev": "pnpm with-env pnpm --filter @superassistant/api dev",
    "worker:dev": "pnpm with-env pnpm --filter @superassistant/worker dev",
    "runner-cli:run": "pnpm with-env pnpm --filter @superassistant/agents runner-cli:run",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
