# Copy to .env and fill in real values. Loaded via: pnpm with-env <command>

# OpenAI (agent model)
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint override (leave empty for api.openai.com)
OPENAI_BASE_URL=

# Exa (searchWeb tool)
EXA_API_KEY=

# Redis (BullMQ; started via: docker compose -f docker-compose.dev.yml up -d)
REDIS_URL=redis://127.0.0.1:6379

# Neo4j graph store (defaults: bolt://127.0.0.1:7687, neo4j, devpassword)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devpassword

# Qdrant vector store (default: http://127.0.0.1:6333)
QDRANT_URL=http://127.0.0.1:6333
